{
  // 메인 대시보드 — 로그인 게이트 + 정적 자산
  // 정본은 d:/개발/anti 2.0 (통합 개발/hong4137.github.io 는 죽은 사본)
  "name": "sharktalk-me",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // SPA 가 아니라 여러 페이지짜리 정적 사이트다. 없는 경로는 404 가 맞다.
    // (SPA 폴백이면 제외한 mgmt-2026 도 index.html 을 200 으로 돌려줘 확인이 불가능해진다)
    "not_found_handling": "none",
    // ★ 필수: 없으면 정적 파일 존재 시 Worker 를 건너뛰어 게이트가 무력화된다
    "run_worker_first": true
  },

  "routes": [
    { "pattern": "me.sharktalk.co.kr", "custom_domain": true }
  ],

  "workers_dev": false,
  "preview_urls": false,

  "kv_namespaces": [
    { "binding": "AUTH", "id": "984a6920775c4133b3e4b258c31e900e", "remote": true }
  ]
}
